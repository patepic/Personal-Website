---
import "../styles/global.css";
import Nav from "../components/nav.astro";
import RotatingText from "../components/rotatingText";
import ProjectsList from "../components/projectsList.astro";
import Footer from "../components/footer.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <title>Patrick's Website</title>
  </head>
  <body class="scroll-smooth">
    <Nav />
    <main>
      <section id="home">
        <div class="home-container">
          <div class="homepage">
            <div class="home-text">
              <h1>Hi, my name is Patrick</h1>
              <RotatingText client:load />
              <p>
                I am a full-stack developer based in Boston, Massachusetts,
                specializing in building web and mobile applications that
                seamlessly blend design and functionality, delivering
                pixel-perfect, visually engaging digital experiences. Whether
                elegant and sleek or fun and imaginative, I take pride in
                crafting experiences that put <b>personality</b>, <b>charm</b>,
                and <b>identity</b> front and center.
              </p>

              <div class="social-buttons-home mt-4 flex gap-4">
                <a
                  href="https://github.com/Patepic"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="social-btn github"
                >
                  <i class="fab fa-github fa"></i><span>GitHub</span>
                </a>

                <a
                  href="https://www.linkedin.com/in/patrick-coulter/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="social-btn linkedin"
                >
                  <i class="fab fa-linkedin fa"></i><span>LinkedIn</span>
                </a>

                <a
                  href="/resume.pdf"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="social-btn resume"
                >
                  <i class="fas fa-file-alt fa"></i><span>Resume</span>
                </a>
              </div>
            </div>
            <div class="home-image">
              <img src="/src/assets/profile1.png" alt="profile" />
            </div>
          </div>
        </div>
        
        <ProjectsList />

        <Footer />
      </section>
    </main>
  </body>
</html>
