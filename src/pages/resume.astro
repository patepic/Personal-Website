---
import "../styles/global.css";
import Nav from "../components/nav.astro";
import Footer from "../components/footer.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css"
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <title>Patrick Coulter | Patrick's Website</title>
  </head>

  <body>
    <Nav />
    <main>
      <div class="resume-container">
        <div class="resume-header">
          <h1>Patrick Coulter</h1>
          <p>Full-Stack Developer • Boston, MA</p>
        </div>
        <section class="resume-section">
          <h2>Work History</h2>
          <div class="timeline">
            <div class="timeline-item">
              <div class="timeline-content">
                <h3>Freelance Full Stack Developer</h3>
                <p class="job-meta">May 2022 – Present</p>
                <ul class="resume-list">
                  <li>
                    Built applications with React, JavaScript, and Java,
                    strengthening expertise in algorithms, data structures, and
                    object-oriented programming.
                  </li>
                  <li>
                    Utilized modern workflows with Git & GitHub for version
                    control and deployed projects through Netlify.
                  </li>
                  <li>
                    Collaborated with local contacts in Boston to provide
                    hands-on support with coding challenges and technical
                    problem-solving.
                  </li>
                  <li>
                    Researched and applied emerging frameworks, automation
                    tools, and programming techniques to expand technical
                    knowledge and adaptability.
                  </li>
                  <li>
                    Delivered small-scale applications and tools that improved
                    efficiency for local contacts and showcased practical
                    software solutions.
                  </li>
                </ul>
                <div class="skill-chips">
                  <span class="skill-chip">React.js</span>
                  <span class="skill-chip">JavaScript</span>
                  <span class="skill-chip">TypeScript</span>
                  <span class="skill-chip">HTML & CSS</span>
                  <span class="skill-chip">Netlify</span>
                </div>
              </div>
            </div>

            <div class="timeline-item">
              <div class="timeline-content">
                <h3>Digital Applications Intern</h3>
                <h4>DynamixE Inc.</h4>
                <p class="job-meta">September 2022 – December 2022</p>
                <ul class="resume-list">
                  <li>
                    Developed a project management system using React.js,
                    Node.js, and Material UI, improving user experience by 30%
                    and reducing load times by 22%.
                  </li>
                  <li>
                    Collaborated with designers, project managers, and engineers
                    to transform concepts into production-ready features,
                    increasing development speed by 20%.
                  </li>
                  <li>
                    Ensured cross-browser compatibility and accessibility
                    compliance, providing a consistent and inclusive user
                    experience across devices.
                  </li>
                  <li>
                    Optimized JavaScript and workflow efficiency, resulting in
                    smoother performance and streamlined development practices.
                  </li>
                </ul>
                <div class="skill-chips">
                  <span class="skill-chip">React.js</span>
                  <span class="skill-chip">JavaScript</span>
                  <span class="skill-chip">HTML & CSS</span>
                  <span class="skill-chip">Node.js</span>
                  <span class="skill-chip">MongoDB</span>
                  <span class="skill-chip">Express.js</span>
                  <span class="skill-chip">Material UI</span>
                </div>
              </div>
            </div>

            <div class="timeline-item">
              <div class="timeline-content">
                <h3>Software Engineer Intern</h3>
                <h4>DynamixE Inc.</h4>
                <p class="job-meta">January 2022 – April 2022</p>
                <ul class="resume-list">
                  <li>
                    Resolved 20+ critical issues in DynamixE’s project
                    management system, including broken links, API errors, and
                    mobile layout problems, improving system reliability and
                    user experience.
                  </li>
                  <li>
                    Collaborated with the engineering team to debug, implement,
                    and document key updates, reducing recurring bugs by 50% and
                    improving maintainability.
                  </li>
                  <li>
                    Ensured cross-browser compatibility and accessibility
                    compliance, providing consistent and inclusive user
                    experience across devices.
                  </li>
                  <li>
                    Optimized front-end and back-end code using React.js,
                    Node.js, and Material UI, boosting application performance
                    and user satisfaction by 20%.
                  </li>
                </ul>
                <div class="skill-chips">
                  <span class="skill-chip">React.js</span>
                  <span class="skill-chip">JavaScript</span>
                  <span class="skill-chip">HTML & CSS</span>
                  <span class="skill-chip">MongoDB</span>
                  <span class="skill-chip">Material UI</span>
                </div>
              </div>
            </div>

            <div class="timeline-item">
              <div class="timeline-content">
                <h3>Freelance Developer</h3>
                <p class="job-meta">March 2020 – December 2021</p>
                <ul class="resume-list">
                  <li>
                    Resolved 20+ critical issues in DynamixE’s project
                    management system, including broken links, API errors, and
                    mobile layout problems, improving system reliability and
                    user experience.
                  </li>
                  <li>
                    Collaborated with the engineering team to debug, implement,
                    and document key updates, reducing recurring bugs by 50% and
                    improving maintainability.
                  </li>
                  <li>
                    Ensured cross-browser compatibility and accessibility
                    compliance, providing a consistent and inclusive user
                    experience across devices.
                  </li>
                  <li>
                    Optimized front-end and back-end code using React.js,
                    Node.js, and Material UI, boosting application performance
                    and user satisfaction by 20%.
                  </li>
                </ul>
                <div class="skill-chips">
                  <span class="skill-chip">React.js</span>
                  <span class="skill-chip">JavaScript</span>
                  <span class="skill-chip">Java</span>
                  <span class="skill-chip">Python</span>
                  <span class="skill-chip">C++</span>
                  <span class="skill-chip">HTML & CSS</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <section class="resume-section">
          <h2>Skills & Tech Stack</h2>
          <div class="skills-grid">
            <div>
              <h3>Frontend</h3>
              <div class="skill-chips">
                <span class="skill-chip">React.js</span>
                <span class="skill-chip">JavaScript</span>
                <span class="skill-chip">TypeScript</span>
                <span class="skill-chip">Astro.js</span>
                <span class="skill-chip">HTML5</span>
                <span class="skill-chip">CSS3</span>
              </div>
            </div>
            <div>
              <h3>Backend</h3>
              <div class="skill-chips">
                <span class="skill-chip">Node.js</span>
                <span class="skill-chip">Express.js</span>
                <span class="skill-chip">Java</span>
                <span class="skill-chip">Python</span>
                <span class="skill-chip">C++</span>
                <span class="skill-chip">C#</span>
              </div>
            </div>
            <div>
              <h3>Databases</h3>
              <div class="skill-chips">
                <span class="skill-chip">MongoDB</span>
                <span class="skill-chip">MySQL</span>
              </div>
            </div>
            <div>
              <h3>Cloud</h3>
              <div class="skill-chips">
                <span class="skill-chip">Firebase</span>
                <span class="skill-chip">Netlify</span>
              </div>
            </div>
            <div>
              <h3>Tools</h3>
              <div class="skill-chips">
                <span class="skill-chip">Git/GitHub</span>
                <span class="skill-chip">VSCode</span>
                <span class="skill-chip">IntelliJ</span>
                <span class="skill-chip">Visual Studio</span>
              </div>
            </div>
            <div>
              <h3>Platforms</h3>
              <div class="skill-chips">
                <span class="skill-chip">Windows</span>
                <span class="skill-chip">Linux (Ubuntu)</span>
                <span class="skill-chip">Android</span>
              </div>
            </div>
            <div class="concepts col-span-2">
              <h3>Concepts</h3>
              <div class="skill-chips">
                <span class="skill-chip">Web Application Development</span>
                <span class="skill-chip">Object-Oriented Programming (OOP)</span
                >
                <span class="skill-chip">Databases (MongoDB, SQL)</span>
                <span class="skill-chip">Responsive Design</span>
                <span class="skill-chip">Version Control (Git)</span>
                <span class="skill-chip">Linux/UNIX Administration</span>
              </div>
            </div>
          </div>
        </section>

        <section class="resume-section">
          <h2>Resume PDF</h2>
          <p>A shortened PDF version of my resume can be downloaded below ↓</p>
          <div class="resume-button">
            <a href="your-resume.pdf" target="_blank" class="btn">
              <i class="fa-solid fa-download"></i> Download Resume
            </a>
          </div>
        </section>
      </div>
    </main>
    <Footer />
  </body>
</html>