---
const { pathname } = Astro.url;
const isHome = pathname === "/";

const projects = [
  { title: "Project 1", desc: "Short description of Project 1.", link: "", best: false },
  { title: "Project 2", desc: "Short description of Project 2.", link: "", best: false },
  { title: "Project 3", desc: "Short description of Project 3.", link: "", best: false },
  { title: "Project 4", desc: "Short description of Project 4.", link: "", best: true },
  { title: "Project 5", desc: "Short description of Project 5.", link: "", best: false },
  { title: "Project 6", desc: "Short description of Project 6.", link: "", best: true },
];

const shownProjects = isHome
  ? projects.filter((p) => p.best)
  : projects;
---

<section id="projects">
  <div class="projects-header">
    <h2>Projects</h2>
    {isHome && (
      <a href="/projects" class="all-projects-link">All Projects →</a>
    )}
  </div>

  <div class="projects-grid">
    {shownProjects.map((project) => (
      <a href={project.link} class={`project-card ${project.best ? "best" : ""}`}>
        <h3>{project.title}</h3>
        <p>{project.desc}</p>
      </a>
    ))}
  </div>
</section>